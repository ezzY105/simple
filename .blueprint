created:
    - database/factories/UserFactory.php
    - database/factories/CategoryFactory.php
    - database/factories/ProductFactory.php
    - database/factories/OrderFactory.php
    - database/factories/OrderItemFactory.php
    - database/factories/PaymentFactory.php
    - database/migrations/2025_03_27_093800_create_users_table.php
    - database/migrations/2025_03_27_093801_create_categories_table.php
    - database/migrations/2025_03_27_093802_create_products_table.php
    - database/migrations/2025_03_27_093803_create_orders_table.php
    - database/migrations/2025_03_27_093804_create_order_items_table.php
    - database/migrations/2025_03_27_093805_create_payments_table.php
    - app/Models/User.php
    - app/Models/Category.php
    - app/Models/Product.php
    - app/Models/Order.php
    - app/Models/OrderItem.php
    - app/Models/Payment.php
models:
    User: { name: string, email: 'string:unique', password: string, created_at: datetime, updated_at: datetime }
    Product: { name: string, description: text, price: 'decimal:8,2', stock: integer, category_id: 'id:foreign:categories', created_at: datetime, updated_at: datetime }
    Cart: { user_id: user_id, items: items }
    Order: { user_id: 'id:foreign:users', status: 'enum[processing, shipped, delivered, cancelled]', total: 'decimal:8,2', created_at: datetime, updated_at: datetime }
    Category: { name: 'string:unique', description: text, created_at: datetime, updated_at: datetime }
    OrderItem: { order_id: 'id:foreign:orders', product_id: 'id:foreign:products', quantity: integer, price: 'decimal:8,2', created_at: datetime, updated_at: datetime }
    Payment: { order_id: 'id:foreign:orders', payment_method: 'enum[credit_card, paypal, bank_transfer]', amount: 'decimal:8,2', status: 'enum[pending, completed, failed]', transaction_id: 'string:nullable', created_at: datetime, updated_at: datetime }
